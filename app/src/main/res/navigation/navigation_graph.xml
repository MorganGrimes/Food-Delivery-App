<?xml version="1.0" encoding="utf-8"?>
 <navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.fooddeliveryapp.ui.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_onBoardingFragment"
            app:destination="@id/onBoardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.example.fooddeliveryapp.ui.onboarding.OnboardingFragment"
        android:label="fragment_on_boarding"
        tools:layout="@layout/fragment_on_boarding">
        <action
            android:id="@+id/action_onBoardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onBoardingFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.fooddeliveryapp.ui.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_authFragment"
            app:destination="@id/authFragment" />
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_loginFragment_to_locationAccessFragment"
            app:destination="@id/locationAccessFragment" />
    </fragment>
    <fragment
        android:id="@+id/authFragment"
        android:name="com.example.fooddeliveryapp.ui.auth.AuthFragment"
        android:label="fragment_auth"
        tools:layout="@layout/fragment_auth" >
        <action
            android:id="@+id/action_authFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.fooddeliveryapp.ui.signup.SignupFragment"
        android:label="fragment_signup"
        tools:layout="@layout/fragment_signup" >
        <action
            android:id="@+id/action_signupFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.fooddeliveryapp.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_foodFragment"
            app:destination="@id/foodFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_myCartFragment"
            app:destination="@id/myCartFragment" />
        <action
            android:id="@+id/action_homeFragment_to_restaurantViewFragment"
            app:destination="@id/restaurantViewFragment" />
    </fragment>
    <fragment
        android:id="@+id/couponDialogFragment"
        android:name="com.example.fooddeliveryapp.ui.coupon.CouponDialogFragment"
        android:label="fragment_coupon_dialog"
        tools:layout="@layout/fragment_coupon_dialog" />
    <fragment
        android:id="@+id/foodFragment"
        android:name="com.example.fooddeliveryapp.ui.food.FoodFragment"
        android:label="fragment_food"
        tools:layout="@layout/fragment_food" >
        <argument
            android:name="selectedCategory"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_foodFragment_to_foodDetailsFragment"
            app:destination="@id/foodDetailsFragment">
        </action>
        <action
            android:id="@+id/action_foodFragment_to_restaurantViewFragment"
            app:destination="@id/restaurantViewFragment" />
        <action
            android:id="@+id/action_foodFragment_to_filterDialogFragment"
            app:destination="@id/filterDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/foodDetailsFragment"
        android:name="com.example.fooddeliveryapp.ui.fooddetails.FoodDetailsFragment"
        android:label="fragment_food_details"
        tools:layout="@layout/fragment_food_details" >
        <argument
            android:name="foodName"
            app:argType="string" />
        <argument
            android:name="restaurantId"
            app:argType="integer" />
        <action
            android:id="@+id/action_foodDetailsFragment_to_myCartFragment"
            app:destination="@id/myCartFragment" />

    </fragment>
     <fragment
        android:id="@+id/restaurantViewFragment"
        android:name="com.example.fooddeliveryapp.ui.restaurantview.RestaurantViewFragment"
        android:label="fragment_restaurant_view"
        tools:layout="@layout/fragment_restaurant_view" >
         <argument
             android:name="restaurantId"
             app:argType="integer" />
        <action
            android:id="@+id/action_restaurantViewFragment_to_foodDetailsFragment"
            app:destination="@id/foodDetailsFragment" />

    </fragment>
    <fragment
        android:id="@+id/filterDialogFragment"
        android:name="com.example.fooddeliveryapp.ui.filter.FilterDialogFragment"
        android:label="fragment_filter_dialog"
        tools:layout="@layout/fragment_filter_dialog" >
    </fragment>
    <fragment
        android:id="@+id/myCartFragment"
        android:name="com.example.fooddeliveryapp.ui.mycart.MyCartFragment"
        android:label="fragment_my_cart"
        tools:layout="@layout/fragment_my_cart" >
        <action
            android:id="@+id/action_myCartFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
        <action
            android:id="@+id/action_myCartFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.fooddeliveryapp.ui.payment.PaymentFragment"
        android:label="fragment_payment"
        tools:layout="@layout/fragment_payment" >
        <argument
            android:name="showBottomBar"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_paymentFragment_to_addCardFragment"
            app:destination="@id/addCardFragment" />
        <action
            android:id="@+id/action_paymentFragment_to_paymentSuccessfullFragment"
            app:destination="@id/paymentSuccessfullFragment" />
    </fragment>
    <fragment
        android:id="@+id/addCardFragment"
        android:name="com.example.fooddeliveryapp.ui.addcard.AddCardFragment"
        android:label="fragment_add_card"
        tools:layout="@layout/fragment_add_card" >
        <action
            android:id="@+id/action_addCardFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>
    <fragment
        android:id="@+id/addressFragment"
        android:name="com.example.fooddeliveryapp.ui.address.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address" >
        <action
            android:id="@+id/action_addressFragment_to_addNewAddressFragment"
            app:destination="@id/addNewAddressFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.fooddeliveryapp.ui.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_personalProfilesFragment"
            app:destination="@id/personalProfilesFragment" />
        <action
            android:id="@+id/action_profileFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myCartFragment"
            app:destination="@id/myCartFragment" />
        <action
            android:id="@+id/action_profileFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myOrdersTabsFragment"
            app:destination="@id/myOrdersTabsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/personalProfilesFragment"
        android:name="com.example.fooddeliveryapp.ui.personalprofiles.PersonalProfilesFragment"
        android:label="fragment_personal_profiles"
        tools:layout="@layout/fragment_personal_profiles" >
        <action
            android:id="@+id/action_personalProfilesFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.fooddeliveryapp.ui.editprofile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" >
        <action
            android:id="@+id/action_editProfileFragment_to_personalProfilesFragment"
            app:destination="@id/personalProfilesFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentSuccessfullFragment"
        android:name="com.example.fooddeliveryapp.ui.paymentsuccessfull.PaymentSuccessfullFragment"
        android:label="PaymentSuccessfullFragment" >
        <action
            android:id="@+id/action_paymentSuccessfullFragment_to_myOrdersTabsFragment"
            app:destination="@id/myOrdersTabsFragment" />
    </fragment>
    <fragment
        android:id="@+id/myOrdersTabsFragment"
        android:name="com.example.fooddeliveryapp.ui.myorderstabs.MyOrdersTabsFragment"
        android:label="fragment_my_orders_tabs"
        tools:layout="@layout/fragment_my_orders_tabs" >
        <action
            android:id="@+id/action_myOrdersTabsFragment_to_ongoingFragment"
            app:destination="@id/ongoingFragment" />
        <action
            android:id="@+id/action_myOrdersTabsFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>
    <fragment
        android:id="@+id/ongoingFragment"
        android:name="com.example.fooddeliveryapp.ui.ongoing.OngoingFragment"
        android:label="fragment_ongoing"
        tools:layout="@layout/fragment_ongoing" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.fooddeliveryapp.ui.history.HistoryFragment"
        android:label="fragment_history"
        tools:layout="@layout/fragment_history" />
    <fragment
        android:id="@+id/addNewAddressFragment"
        android:name="com.example.fooddeliveryapp.ui.addnewaddress.AddNewAddressFragment"
        android:label="fragment_add_new_address"
        tools:layout="@layout/fragment_add_new_address" >
                <action
            android:id="@+id/action_addNewAddressFragment_to_addressFragment"
            app:destination="@id/addressFragment">
        </action>
    </fragment>
    <fragment
        android:id="@+id/locationAccessFragment"
        android:name="com.example.fooddeliveryapp.ui.locationaccess.LocationAccessFragment"
        android:label="fragment_location_access"
        tools:layout="@layout/fragment_location_access" >
        <action
            android:id="@+id/action_locationAccessFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>