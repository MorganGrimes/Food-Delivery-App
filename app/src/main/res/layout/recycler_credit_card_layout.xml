<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:backgroundTint="@color/white_grey"
    app:cardCornerRadius="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp">

        <TextView
            android:id="@+id/recycler_credit_card_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/sen_bold"
            android:text="@string/master_card"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/recycler_credit_card_icon_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:src="@drawable/mastercard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recycler_credit_card_name_tv" />

        <TextView
            android:id="@+id/recycler_pin_credit_card_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/sen_regular"
            android:text="@string/pin_credit_card_obscured"
            android:textColor="@color/edit_text_white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/recycler_credit_card_icon_iv"
            app:layout_constraintStart_toEndOf="@+id/recycler_credit_card_icon_iv"
            app:layout_constraintTop_toTopOf="@+id/recycler_credit_card_icon_iv" />

        <TextView
            android:id="@+id/last_three_number_pin_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/sen_regular"
            android:text="@string/_436"
            android:textColor="@color/edit_text_white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/recycler_pin_credit_card_tv"
            app:layout_constraintStart_toEndOf="@+id/recycler_pin_credit_card_tv"
            app:layout_constraintTop_toTopOf="@+id/recycler_pin_credit_card_tv" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@drawable/arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>