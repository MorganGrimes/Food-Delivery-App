<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="32dp"
    android:background="@color/deep_blue">

    <androidx.cardview.widget.CardView
        android:id="@+id/cart_item_cv"
        android:layout_width="136dp"
        android:layout_height="117dp"
        app:cardCornerRadius="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/recycler_cart_item_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black_light" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/recycler_cart_item_food_title_tv"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/sen_bold"
        android:text="@string/pizza_calzone_european"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cart_item_cv"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/recycler_cart_item_remove_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/remove_item_cart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/recycler_cart_item_food_price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/sen_bold"
        android:text="@string/_64"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/recycler_cart_item_food_title_tv"
        app:layout_constraintTop_toBottomOf="@+id/recycler_cart_item_food_title_tv" />

    <TextView
        android:id="@+id/recycler_cart_item_food_size_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="17dp"
        android:fontFamily="@font/sen_bold"
        android:text="@string/_14"
        android:textColor="@color/grey"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/recycler_cart_item_food_price_tv"
        app:layout_constraintTop_toBottomOf="@+id/recycler_cart_item_food_price_tv" />

    <LinearLayout
        android:id="@+id/recycler_cart_item_add_remove_btn_ll_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/recycler_cart_item_food_size_tv"
        app:layout_constraintStart_toEndOf="@+id/recycler_cart_item_food_size_tv"
        app:layout_constraintTop_toTopOf="@+id/recycler_cart_item_food_size_tv">

        <ImageView
            android:id="@+id/recycler_cart_item_minus_icon_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/minus" />

        <TextView
            android:id="@+id/recycler_cart_item_number_selected_food_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/sen_regular"
            android:text="@string/_1"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/recycler_cart_item_plus_icon_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/plus" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>