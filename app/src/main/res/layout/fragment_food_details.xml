<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fooddetails.FoodDetailsFragment">

    <LinearLayout
        android:id="@+id/food_details_top_bar_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="50dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/food_details_back_icon_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_arrow_grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/details_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/sen_regular"
            android:text="@string/details"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/food_details_back_icon_iv"
            app:layout_constraintStart_toEndOf="@+id/food_details_back_icon_iv"
            app:layout_constraintTop_toTopOf="@+id/food_details_back_icon_iv" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@id/food_details_bottom_cw"
        app:layout_constraintTop_toBottomOf="@id/food_details_top_bar_ll">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="44dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/restaurants_cw"
                android:layout_width="326dp"
                android:layout_height="184dp"
                app:cardCornerRadius="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/food_details_restaurants_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/grey"
                    tools:ignore="ContentDescription,ImageContrastCheck" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_corners"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/restaurants_cw">

                <TextView
                    android:id="@+id/food_details_restaurant_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/sen_regular"
                    android:gravity="center"
                    android:text="@string/uttora_coffe_house"
                    android:textColor="@color/black_light"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/house"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/restaurants_cw" />
            </LinearLayout>

            <TextView
                android:id="@+id/food_details_title_tv"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sen_bold"
                android:text="@string/pizza_calzone_european"
                android:textColor="@color/black_light"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

            <TextView
                android:id="@+id/food_details_description_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sen_regular"
                android:text="@string/pizza_description"
                android:textColor="@color/grey"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/food_details_title_tv" />

            <LinearLayout
                android:id="@+id/food_details_rating_delivery_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/food_details_description_tv">

                <TextView
                    android:id="@+id/food_details_rating_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/sen_bold"
                    android:gravity="bottom"
                    android:text="@string/rating"
                    android:textColor="@color/black_light"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/star"
                    app:drawableTint="@color/orange" />

                <TextView
                    android:id="@+id/food_details_delivery_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/sen_regular"
                    android:gravity="bottom"
                    android:text="@string/delivery_type"
                    android:textColor="@color/black_light"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/delivery"
                    app:drawableTint="@color/orange" />

                <TextView
                    android:id="@+id/food_details_delivery_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/sen_regular"
                    android:gravity="bottom"
                    android:text="@string/delivery_time"
                    android:textColor="@color/black_light"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/clock"
                    app:drawableTint="@color/orange" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/size_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/food_details_rating_delivery_ll">

                <TextView
                    android:id="@+id/size_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/sen_regular"
                    android:text="@string/size"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/food_details_first_size_btn"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/edit_text_white"
                    android:fontFamily="@font/sen_regular"
                    android:text="@string/ten"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/food_details_second_size_btn"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/edit_text_white"
                    android:fontFamily="@font/sen_regular"
                    android:text="@string/fourteen"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/food_details_third_size_btn"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/edit_text_white"
                    android:fontFamily="@font/sen_regular"
                    android:text="@string/sixteen"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/ingredients_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/sen_regular"
                android:text="@string/ingredients"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/size_ll" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ingredients_tv">

                <LinearLayout
                    android:id="@+id/ingredients_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/salt_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/salt"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/salt" />

                    <TextView
                        android:id="@+id/chicken_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/chicken"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/chicken" />

                    <TextView
                        android:id="@+id/onion_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/onion"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/onion" />

                    <TextView
                        android:id="@+id/garlic_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/garlic"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/garlic" />

                    <TextView
                        android:id="@+id/pappers_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/pappers"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/pappers" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ingredients_ll2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ingredients_ll">

                    <TextView
                        android:id="@+id/ginger_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/ginger"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/ginger" />

                    <TextView
                        android:id="@+id/broccoli_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/broccoli"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/broccoli" />

                    <TextView
                        android:id="@+id/orange_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/orange"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/orange" />

                    <TextView
                        android:id="@+id/walnut_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sen_regular"
                        android:text="@string/walnut"
                        android:textAlignment="center"
                        app:drawableTopCompat="@drawable/walnut" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/food_details_bottom_cw"
        style="@style/CustomCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="@color/edit_text_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/edit_text_white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/food_details_total_food_price_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/sen_regular"
                android:text="@string/_32"
                android:textColor="@color/black"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="@+id/btn_ll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btn_ll" />

            <LinearLayout
                android:id="@+id/btn_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/rounded_corners"
                android:backgroundTint="@color/black"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/food_details_minus_icon_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/minus" />

                <TextView
                    android:id="@+id/food_details_number_selected_food_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="@font/sen_regular"
                    android:text="@string/_2"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/food_details_plus_icon_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/plus" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_to_cart_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="30dp"
                android:backgroundTint="@color/orange"
                android:fontFamily="@font/sen_bold"
                android:paddingVertical="20dp"
                android:text="@string/add_to_cart"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_ll" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>